# Kali AI — Environment Configuration
# Copy this file to .env and fill in your values
# Or just run:  python3 cli.py  — the setup wizard will configure everything automatically!

# ── Active AI Provider ────────────────────────────────────────────────────────
# Options: gemini | openai | anthropic | ollama | demo
# The setup wizard sets this automatically.
ACTIVE_PROVIDER=gemini

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Free tier: 1500 requests/day with gemini-3.8-flash
# Get your key → https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# RECOMMENDED model (fastest, free, 1500 req/day):
GEMINI_MODEL=gemini-3.8-flash

# ── OpenAI GPT (optional) ─────────────────────────────────────────────────────
# Get your key → https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic Claude (optional) ───────────────────────────────────────────────
# Get your key → https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Ollama — Local LLM (FREE, no rate limits, runs on your machine) ───────────
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Start:   ollama serve
# Pull:    ollama pull llama3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Agent Limits ──────────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=10
MAX_TOOL_CALLS=15
TOOL_EXECUTION_TIMEOUT=120

# ── Security ──────────────────────────────────────────────────────────────────
# Allowed targets (comma-separated CIDR ranges and hostnames)
# Use '*' to allow scanning any target (HexStrike / Pentest mode)
ALLOWED_TARGETS=*
