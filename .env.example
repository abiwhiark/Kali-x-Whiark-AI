# Kali AI — Environment Configuration
# Copy this file to .env and fill in your values
# Or simply run: python3 cli.py  — the setup wizard will configure everything automatically!

# ── Active AI Provider ────────────────────────────────────────────────────────
# Options: gemini | openai | anthropic | ollama | demo
ACTIVE_PROVIDER=gemini

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your free key → https://aistudio.google.com/apikey
# gemini-2.5-flash: RECOMMENDED (Fast, generous free tier)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI GPT (optional) ─────────────────────────────────────────────────────
# Get your key → https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic Claude (optional) ───────────────────────────────────────────────
# Get your key → https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Ollama — Local LLM (FREE, no rate limits, runs offline) ───────────────────
# Install on Kali: chmod +x ollama/install_kali_ollama.sh && ./ollama/install_kali_ollama.sh
# Or manually:     ollama pull qwen2.5:7b && ollama create kali-cyber -f ollama/Modelfile.kali-cyber
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=kali-cyber

# ── Agent Limits ──────────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=10
MAX_TOOL_CALLS=15
TOOL_EXECUTION_TIMEOUT=120

# ── Security ──────────────────────────────────────────────────────────────────
# Allowed targets (comma-separated CIDR ranges and hostnames)
# Use '*' to allow scanning any target (HexStrike / Pentest mode)
ALLOWED_TARGETS=*
