# Kali AI - Environment Configuration
# Copy this file to .env and fill in your values

# Gemini API Key (get from https://aistudio.google.com/apikey)
# Leave empty to run in Demo Mode
GEMINI_API_KEY=your_key_here

# Gemini Model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Maximum agent loop iterations per assessment
MAX_AGENT_ITERATIONS=10

# Maximum tool calls per assessment
MAX_TOOL_CALLS=15

# Tool execution timeout in seconds
TOOL_EXECUTION_TIMEOUT=120

# Allowed targets (comma-separated CIDR ranges and hostnames)
# Use '*' to allow scanning any target (HexStrike / Pentest mode)
ALLOWED_TARGETS=*
